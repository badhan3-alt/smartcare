# Copy to .env for local development. Generate a unique secret before starting:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production: set DJANGO_DEBUG=False, use your real hostname and HTTPS origin,
# DJANGO_ALLOWED_HOSTS=smartcare.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://smartcare.example.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SMARTCARE_SMS_WEBHOOK_URL=
